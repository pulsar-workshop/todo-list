{
  "id": "com.riclud.todo",
  "name": "todo-list",
  "version": "0.1.0",
  "main": "src/main.ts",
  "targets": ["desktop", "android"],
  "compat": "portable",
  "windows": [
    {
      "label": "main",
      "width": 800,
      "height": 600,
      "title": "Todo List"
    }
  ],
  "permissions": [
    "storage",
    "fs",
    "paths",
    "dialog",
    "net",
    "clipboard",
    "share",
    "notify",
    "permissions",
    "theme"
  ],
  "osPermissions": ["notifications"]
}
