{
  "name": "todo-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "QT_QUICK_CONTROLS_STYLE=${QT_QUICK_CONTROLS_STYLE:-Material} pulsar dev",
    "start": "pulsar run",
    "build": "pulsar build",
    "server": "bun server.ts",
    "db:generate": "drizzle-kit generate && bun scripts/embed-migrations.ts",
    "build:server": "bun build --compile --minify server.ts --outfile dist/todo-sync",
    "build:server:linux": "bun build --compile --minify --target=bun-linux-x64 server.ts --outfile dist/todo-sync-linux-x64",
    "build:server:arm64": "bun build --compile --minify --target=bun-linux-arm64 server.ts --outfile dist/todo-sync-linux-arm64",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
